generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  PROFESSOR
}
enum AuditResult {
  SUCCESS
  FAILURE
}
enum EixoBNCC {
  PENSAMENTO_COMPUTACIONAL
  MUNDO_DIGITAL
  CULTURA_DIGITAL
}
enum PlanStatus {
  RASCUNHO
  FINALIZADO
}
enum AiRunStatus {
  PENDING
  SUCCEEDED
  FAILED
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role Role @default(PROFESSOR)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  audits AuditEvent[]
  aiRuns AiRun[]
  plans Plan[]
}
model Session {
  id String @id @default(uuid())
  userId String
  refreshTokenHash String
  familyId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([familyId])
}
model AuditEvent {
  id String @id @default(uuid())
  type String
  result AuditResult
  userId String?
  sessionId String?
  context Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
}
model NivelEnsino {
  id String @id @default(uuid())
  codigo String @unique
  nome String @unique
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  etapas EtapaEnsino[]
}
model EtapaEnsino {
  id String @id @default(uuid())
  nivelEnsinoId String
  codigo String
  nome String
  anoInicial Int?
  anoFinal Int?
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nivel NivelEnsino @relation(fields:[nivelEnsinoId], references:[id], onDelete: Restrict)
  habilidades HabilidadeBNCC[]
  @@unique([nivelEnsinoId,codigo])
  @@unique([nivelEnsinoId,nome])
  @@index([nivelEnsinoId,ativo])
}
model HabilidadeBNCC {
  id String @id @default(uuid())
  etapaEnsinoId String
  codigo String @unique
  eixo EixoBNCC?
  descricao String
  explicacao String
  ativa Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  etapa EtapaEnsino @relation(fields:[etapaEnsinoId], references:[id], onDelete: Restrict)
  exemplos ExemploHabilidadeBNCC[]
  aiRunSkills AiRunSkill[]
  @@index([etapaEnsinoId,ativa,eixo,codigo])
}
model ExemploHabilidadeBNCC {
  id String @id @default(uuid())
  habilidadeBNCCId String
  ordem Int
  texto String
  habilidade HabilidadeBNCC @relation(fields:[habilidadeBNCCId], references:[id], onDelete: Cascade)
  @@unique([habilidadeBNCCId,ordem])
}
model AiRun {
  id String @id @default(uuid())
  requesterId String
  requestId String @unique
  idempotencyKey String @unique
  status AiRunStatus @default(PENDING)
  instruction String
  durationMinutes Int
  usesDigitalResources Boolean
  attemptCount Int @default(1)
  failureCode String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  skills AiRunSkill[]
  plan Plan?
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}
model AiRunSkill {
  id String @id @default(uuid())
  aiRunId String
  habilidadeBNCCId String
  ordem Int
  aiRun AiRun @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  habilidade HabilidadeBNCC @relation(fields: [habilidadeBNCCId], references: [id], onDelete: Restrict)
  @@unique([aiRunId, habilidadeBNCCId])
  @@unique([aiRunId, ordem])
}
model Plan {
  id String @id @default(uuid())
  ownerId String
  aiRunId String @unique
  status PlanStatus @default(RASCUNHO)
  markdown String
  aiAssisted Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finalizedAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  aiRun AiRun @relation(fields: [aiRunId], references: [id], onDelete: Restrict)
  references PlanReference[]
  @@index([ownerId, status, updatedAt])
  @@index([status, updatedAt])
}
model PlanReference {
  id String @id @default(uuid())
  planId String
  title String
  url String?
  citation String?
  ordem Int
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, ordem])
}
